local function getGuiParent()
    local ok, parent = pcall(function()
        return (gethui and gethui()) or game:GetService("CoreGui")
    end)
    return ok and parent or player:WaitForChild("PlayerGui")
end

local function removeOld(name)
    local parents = { player:WaitForChild("PlayerGui"), workspace.CurrentCamera, getGuiParent() }
    pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
    for _, parent in ipairs(parents) do
        pcall(function()
            local old = parent:FindFirstChild(name)
            if old then old:Destroy() end
        end)
    end
end

env.ZenithCleanup = function()
    alive = false
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    for _, fn in ipairs(cleanups) do pcall(fn) end
    for _, n in ipairs({ "ZenithShootGui", "ZenithKnifeGui", "ZenithAskLock", "ZenithGunHud", "ZenithESP" }) do
        pcall(removeOld, n)
    end
    pcall(function() if Window then Window:Destroy() end end)
end

local function notify(text, secs)
    WindUI:Notify({ Title = "Zenith Hub", Content = text, Duration = secs or 3 })
end

local function safe(name, fn)
    local ok, err = pcall(fn)
    if not ok then warn("[Zenith Hub] แท็บ " .. name .. " ผิดพลาด:", err) end
    task.wait()
end

local function getHumanoid()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function hasTool(p, name)
    local c = p.Character
    return (c and c:FindFirstChild(name)) or p.Backpack:FindFirstChild(name)
end

local function equipTool(name)
    local tool = hasTool(player, name)
    local hum = getHumanoid()
    if tool and hum and tool.Parent ~= player.Character then
        hum:EquipTool(tool)
        task.wait(0.15)
    end
    return tool
end

