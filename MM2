safe("ESP", function()
    local Tab = Window:Tab({ Title = "ESP", Icon = "scan-eye" })

    local ROLE_COLORS = {
        Innocent = Color3.fromRGB(0, 255, 0),
        Sheriff  = Color3.fromRGB(0, 120, 255),
        Murderer = Color3.fromRGB(255, 0, 0),
        Hero     = Color3.fromRGB(255, 255, 0),
    }
    local ROLE_TEXT = {
        Innocent = "ผู้บริสุทธิ์",
        Sheriff  = "นายอำเภอ",
        Murderer = "ฆาตกร",
        Hero     = "ฮีโร่",
    }

    local espOn = false
    local showName, showProfile, showDist, showHealth = true, true, true, false
    local showRole = { Innocent = true, Sheriff = true, Murderer = true, Hero = true }
    local gunEspOn, coinEspOn = false, false

    local espObjects, tracers, coinEsps = {}, {}, {}
    local gunEsp = nil
    local tracerConn = nil

    -- ฮิตบล็อก: ตัวแปรสถานะ
    local hitboxOn, hitboxes = false, {}
    local hbxOn, hbxAll, hbxSize = false, false, 10
    local hbxOriginal = {}

    -- ให้ระบบอ่านบทบาททำงานเมื่อมีฟีเจอร์ที่ต้องใช้บทบาทเปิดอยู่
    local function syncRoleFlag()
        flags.esp = espOn or hitboxOn or hbxOn
    end

    removeOld("ZenithESP")
    local espParent = workspace.CurrentCamera
    pcall(function()
        local cg = game:GetService("CoreGui")
        local test = Instance.new("Folder")
        test.Parent = cg
        if test.Parent == cg then espParent = cg end
        test:Destroy()
    end)
    local espFolder = Instance.new("Folder")
    espFolder.Name = "ZenithESP"
    espFolder.Parent = espParent

    -- ---------- ESP ผู้เล่น ----------
    local function clearESP(p)
        local obj = espObjects[p]
        if obj then
            if obj.highlight then obj.highlight:Destroy() end
            if obj.gui then obj.gui:Destroy() end
            espObjects[p] = nil
        end
    end

    local function clearAllESP()
        for p in pairs(espObjects) do clearESP(p) end
    end

    local function createESP(p, char, head)
        local highlight = Instance.new("Highlight")
        highlight.Adornee = char
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = espFolder

        local gui = Instance.new("BillboardGui")
        gui.Adornee = head
        gui.Size = UDim2.fromOffset(140, 100)
        gui.StudsOffset = Vector3.new(0, 3.5, 0)
        gui.AlwaysOnTop = true
        gui.Parent = espFolder

        local image = Instance.new("ImageLabel")
        image.Size = UDim2.fromOffset(44, 44)
        image.Position = UDim2.new(0.5, -22, 0, 0)
        image.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        image.Image = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=150&h=150"
        image.Parent = gui
        Instance.new("UICorner", image).CornerRadius = UDim.new(1, 0)
        local stroke = Instance.new("UIStroke", image)
        stroke.Thickness = 2

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 0, 52)
        label.Position = UDim2.fromOffset(0, 46)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextSize = 13
        label.TextStrokeTransparency = 0.3
        label.Parent = gui

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Died:Connect(function() clearESP(p) end)
        end
        char.AncestryChanged:Connect(function(_, parent)
            if not parent then clearESP(p) end
        end)

        espObjects[p] = {
            char = char, highlight = highlight, gui = gui,
            image = image, stroke = stroke, label = label,
            color = Color3.new(1, 1, 1),
        }
    end

    local function updateESP()
        -- อ่านบทบาทได้ แต่ยังไม่เริ่มรอบ (ล็อบบี้) ให้ล้าง ESP
        if rolesOk and not roundActive() then
            clearAllESP()
            return
        end

        local myRoot = getRoot()

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local head = char and char:FindFirstChild("Head")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local role = getRole(p) or "Innocent"

                if not (hum and head and root and hum.Health > 0 and isAlive(p)) or not showRole[role] then
                    clearESP(p)
                else
                    local obj = espObjects[p]
                    if obj and obj.char ~= char then
                        clearESP(p)
                        obj = nil
                    end
                    if not obj then
                        createESP(p, char, head)
                        obj = espObjects[p]
                    end

                    local color = ROLE_COLORS[role]
                    obj.color = color
                    obj.highlight.FillColor = color
                    obj.highlight.OutlineColor = color
                    obj.stroke.Color = color
                    obj.label.TextColor3 = color

                    local lines = {}
                    if showName then table.insert(lines, p.DisplayName) end
                    table.insert(lines, "[" .. ROLE_TEXT[role] .. "]")
                    if showDist and myRoot then
                        table.insert(lines, math.floor((root.Position - myRoot.Position).Magnitude) .. " เมตร")
                    end
                    if showHealth then
                        table.insert(lines, "เลือด " .. math.floor(hum.Health))
                    end
                    obj.label.Text = table.concat(lines, "\n")
                    obj.image.Visible = showProfile
                end
            end
        end
    end

    -- ---------- ESP ปืนที่ตก + เหรียญ ----------
    local function clearGunEsp()
        if gunEsp then
            gunEsp.box:Destroy()
            gunEsp.highlight:Destroy()
            gunEsp.gui:Destroy()
            gunEsp = nil
        end
    end

    local function clearCoinEsps()
        for coin, b in pairs(coinEsps) do
            b:Destroy()
            coinEsps[coin] = nil
        end
    end

    local function updateItemESP()
        local drop = getGunPart()
        if gunEspOn and drop then
            if not gunEsp or gunEsp.drop ~= drop then
                clearGunEsp()

                local box = Instance.new("BoxHandleAdornment")
                box.Adornee = drop
                box.Size = drop.Size + Vector3.new(0.6, 0.6, 0.6)
                box.Color3 = Color3.fromRGB(255, 255, 0)
                box.Transparency = 0.3
                box.AlwaysOnTop = true
                box.ZIndex = 5
                box.Parent = espFolder

                local highlight = Instance.new("Highlight")
                highlight.Adornee = drop
                highlight.FillColor = Color3.fromRGB(255, 255, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = espFolder

                local gui = Instance.new("BillboardGui")
                gui.Adornee = drop
                gui.Size = UDim2.fromOffset(140, 40)
                gui.StudsOffset = Vector3.new(0, 3, 0)
                gui.AlwaysOnTop = true
                gui.Parent = espFolder

                local label = Instance.new("TextLabel")
                label.Size = UDim2.fromScale(1, 1)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.GothamBold
                label.TextSize = 15
                label.TextColor3 = Color3.fromRGB(255, 255, 0)
                label.TextStrokeTransparency = 0.2
                label.Parent = gui

                gunEsp = { drop = drop, box = box, highlight = highlight, gui = gui, label = label }
            end
            local root = getRoot()
            local dist = root and math.floor((drop.Position - root.Position).Magnitude) or 0
            gunEsp.label.Text = "🔫 ปืนที่ตก\n" .. dist .. " เมตร"
        else
            clearGunEsp()
        end

        if coinEspOn then
            local current = {}
            for _, coin in ipairs(getCoins()) do
                current[coin] = true
                if not coinEsps[coin] then
                    local b = Instance.new("BoxHandleAdornment")
                    b.Adornee = coin
                    b.Size = Vector3.new(1.8, 1.8, 1.8)
                    b.Color3 = Color3.fromRGB(255, 200, 0)
                    b.Transparency = 0.25
                    b.AlwaysOnTop = true
                    b.ZIndex = 5
                    b.Parent = espFolder
                    coinEsps[coin] = b
                end
            end
            for coin, b in pairs(coinEsps) do
                if not current[coin] then
                    b:Destroy()
                    coinEsps[coin] = nil
                end
            end
        else
            clearCoinEsps()
        end
    end

    -- ---------- ฮิตบล็อกแบบวาดกล่อง (ปรับขนาด/สี/ความโปร่งใสได้) ----------
    local hbW, hbH, hbD = 100, 100, 100 -- เปอร์เซ็นต์ของขนาดตัวละครจริง
    local hbTransp, hbRoleColor, hbRange = 0.6, true, 300
    local hbColor = Color3.fromRGB(80, 160, 255)

    local function clearHitbox(p)
        local b = hitboxes[p]
        if b then
            b:Destroy()
            hitboxes[p] = nil
        end
    end

    local function clearAllHitboxes()
        for p in pairs(hitboxes) do clearHitbox(p) end
    end

    local function updateHitboxes()
        if not hitboxOn or (rolesOk and not roundActive()) then
            clearAllHitboxes()
            return
        end
        local myRoot = getRoot()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local inRange = true
                if myRoot and root then
                    inRange = (root.Position - myRoot.Position).Magnitude <= hbRange
                end

                if not (hum and root and hum.Health > 0 and isAlive(p) and inRange) then
                    clearHitbox(p)
                else
                    local box = hitboxes[p]
                    if box and box.Adornee ~= root then
                        clearHitbox(p)
                        box = nil
                    end
                    if not box then
                        box = Instance.new("BoxHandleAdornment")
                        box.Adornee = root
                        box.AlwaysOnTop = true
                        box.ZIndex = 4
                        box.Parent = espFolder
                        hitboxes[p] = box
                    end

                    local bbCF, bbSize = char:GetBoundingBox()
                    box.CFrame = root.CFrame:ToObjectSpace(bbCF)
                    box.Size = Vector3.new(
                        bbSize.X * hbW / 100,
                        bbSize.Y * hbH / 100,
                        bbSize.Z * hbD / 100
                    )
                    box.Transparency = hbTransp
                    if hbRoleColor then
                        box.Color3 = ROLE_COLORS[getRole(p) or "Innocent"]
                    else
                        box.Color3 = hbColor
                    end
                end
            end
        end
    end

    -- ---------- ฮิตบล็อกขยายจริง (ทดลอง) ----------
    local function restoreHbx(p)
        local data = hbxOriginal[p]
        if data then
            local part = data.part
            if part and part.Parent then
                pcall(function()
                    part.Size = data.Size
                    part.Transparency = data.Transparency
                    part.CanCollide = data.CanCollide
                    part.Massless = data.Massless
                end)
            end
            hbxOriginal[p] = nil
        end
    end

    local function applyHbx()
