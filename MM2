    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = Color3.new(1, 1, 1)
    local strokeGrad = Instance.new("UIGradient", stroke)
    strokeGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, cfg.top),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
    })

    local icon = Instance.new("TextLabel")
    icon.BackgroundTransparency = 1
    icon.Size = UDim2.new(1, 0, 0.55, 0)
    icon.Position = UDim2.fromScale(0, 0.08)
    icon.Text = cfg.icon
    icon.TextSize = 30
    icon.Font = Enum.Font.GothamBold
    icon.Parent = btn

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0.3, 0)
    label.Position = UDim2.fromScale(0, 0.58)
    label.Text = cfg.text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.5
    label.Parent = btn

    -- ปุ่มล็อกตำแหน่ง (ซ่อนไว้ก่อน จะโชว์เมื่อผู้ใช้เลือก "เพิ่ม")
    local locked = false
    local lockBtn = Instance.new("TextButton")
    lockBtn.Size = UDim2.fromOffset(30, 30)
    lockBtn.Position = UDim2.new(1, -30, 0, 0)
    lockBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    lockBtn.Text = "🔓"
    lockBtn.TextSize = 16
    lockBtn.Font = Enum.Font.GothamBold
    lockBtn.Visible = false
    lockBtn.ZIndex = 5
    lockBtn.Parent = holder
    Instance.new("UICorner", lockBtn).CornerRadius = UDim.new(1, 0)
    local lockStroke = Instance.new("UIStroke", lockBtn)
    lockStroke.Color = Color3.new(1, 1, 1)
    lockStroke.Thickness = 2

    lockBtn.Activated:Connect(function()
        locked = not locked
        lockBtn.Text = locked and "🔒" or "🔓"
        lockBtn.BackgroundColor3 = locked and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(40, 40, 50)
        notify(locked and "ล็อกตำแหน่งปุ่มแล้ว" or "ปลดล็อกปุ่มแล้ว", 2)
    end)

    local function setLockVisible(v)
        lockBtn.Visible = v
        if not v then
            locked = false
            lockBtn.Text = "🔓"
            lockBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        end
    end

    task.spawn(function()
        local rot = 0
        while alive and gui.Parent do
            if gui.Enabled then
                rot = (rot + 6) % 360
                strokeGrad.Rotation = rot
            end
            task.wait(0.06)
        end
    end)

    local cooling = false
    local function fire()
        if cooling then return end
        cooling = true

        TweenService:Create(btn, TweenInfo.new(0.08), { Size = UDim2.fromOffset(68, 68) }):Play()
        task.delay(0.08, function()
            TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(80, 80) }):Play()
        end)

        task.spawn(cfg.onTap)

        grad.Color = grayColor
        label.Text = "รอ..."
        task.delay(cfg.cooldown, function()
            grad.Color = normalColor
            label.Text = cfg.text
            cooling = false
        end)
    end

    local dragging, dragStart, startPos, moved = false, nil, nil, false

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging, moved = true, false
            dragStart = input.Position
            startPos = holder.Position
        end
    end)

    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and not locked and (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 8 then moved = true end
            if moved then
                holder.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1) then
            dragging = false
            if not moved then fire() end
        end
    end))

    -- ตัวควบคุม: ตั้ง .Enabled ได้เหมือนเดิม แต่จะถามเรื่องปุ่มล็อกตอนเปิด
    return setmetatable({}, {
        __index = function(_, k)
            if k == "Enabled" then return gui.Enabled end
