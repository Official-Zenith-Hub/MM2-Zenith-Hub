local gunCache, gunScanAt, gunNameOverride = nil, 0, nil

local function findGunNow()
    -- 0) ชื่อที่ผู้ใช้ตั้งเอง
    if gunNameOverride then
        local o = workspace:FindFirstChild(gunNameOverride, true)
        if o then return o end
    end
    -- 1) ตำแหน่งปกติ (ลูกของ workspace โดยตรง)
    local d = workspace:FindFirstChild("GunDrop") or workspace:FindFirstChild("Gun")
    if d then return d end
    -- 2) ซ้อนอยู่ข้างในโฟลเดอร์/โมเดลอื่น
    return workspace:FindFirstChild("GunDrop", true)
end

local function getGunObject()
    if gunCache and gunCache:IsDescendantOf(workspace) then return gunCache end
    gunCache = nil
    if tick() - gunScanAt < 1 then return nil end
    gunScanAt = tick()
    gunCache = findGunNow()
    return gunCache
end

local function getGunPart()
    local d = getGunObject()
    if not d then return nil end
    if d:IsA("BasePart") then return d end
    return d:FindFirstChildWhichIsA("BasePart", true)
end

track(workspace.ChildAdded:Connect(function(child)
    if child.Name == "GunDrop" or child.Name == "Gun" then
        gunCache = child
    end
end))

