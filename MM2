    local retryAt, notifiedDead = 0, false

    -- ---------- วาร์ปไปเก็บปืน ----------
    Tab:Toggle({
        Title = "วาร์ปไปเก็บปืน (เมื่อนายอำเภอตาย)",
        Value = false,
        Callback = function(state)
            autoGrab = state
            flags.grab = state
            notifiedNoDrop = false
            if state and not getGunPart() and not hasTool(player, "Gun") then
                notifiedNoDrop = true
                notify("ปืนยังไม่ drop")
            end
        end,
    })

    local function touchGun(r, drop)
        if firetouchinterest then
            pcall(function()
                firetouchinterest(r, drop, 0)
                firetouchinterest(r, drop, 1)
            end)
        end
    end

    task.spawn(function()
        while alive do
            task.wait(0.2)
            if autoGrab and not grabbing and tick() >= retryAt then
                local drop = getGunPart()
                if not amPlaying() then
                    -- ตายแล้ว/อยู่ล็อบบี้: เกมไม่ให้เก็บปืน หยุดรอ
                    if drop and not notifiedDead then
                        notifiedDead = true
                        notify("ตายแล้วหรืออยู่ล็อบบี้ เก็บปืนไม่ได้ (จะทำงานเองรอบหน้า)", 4)
                    end
                else
                    notifiedDead = false
                    local root = getRoot()
                    if not drop then
                        if not notifiedNoDrop and not hasTool(player, "Gun") then
                            notifiedNoDrop = true
                            notify("ปืนยังไม่ drop")
                        end
                    else
                        notifiedNoDrop = false
                        if root and not hasTool(player, "Gun") and getRole(player) ~= "Murderer" then
                            grabbing = true
                            pcall(function()
                                local back = root.CFrame

                                -- แวบไปที่ปืน แล้วกลับทันทีที่ได้ปืน (เช็กทุกเฟรม)
                                local t = 0
                                while alive and t < 1.5 and drop.Parent and not hasTool(player, "Gun") do
                                    local r = getRoot()
                                    if not r then break end
                                    r.CFrame = drop.CFrame
                                    touchGun(r, drop)
                                    t += RunService.Heartbeat:Wait()
                                end

                                local r2 = getRoot()
                                if r2 then r2.CFrame = back end
                            end)

                            -- ถ้ายังไม่ได้ปืน พักก่อนค่อยลองใหม่
                            if not hasTool(player, "Gun") and getGunPart() then
                                retryAt = tick() + 4
                            end
                            grabbing = false
                        end
                    end
                end
            end
        end
    end)

    -- ---------- แจ้งเตือนเมื่อปืนตก ----------
    Tab:Toggle({
        Title = "แจ้งเตือนเมื่อปืนตก",
        Value = false,
        Callback = function(state) notifyGun = state end,
    })

    task.spawn(function()
        local lastGun = nil
        while alive do
            task.wait(0.4)
            if notifyGun then
                local g = getGunPart()
                if g and g ~= lastGun then
                    notify("ปืนตกแล้ว! นายอำเภอตาย", 4)
                end
                lastGun = g
            else
                lastGun = nil
            end
        end
    end)

    -- ---------- ช่องตั้งชื่อปืนเอง (ถ้าหาไม่เจอ) ----------
    pcall(function()
        Tab:Input({
            Title = "ชื่อปืนที่ตก (ตั้งเอง ถ้าหาไม่เจอ)",
            Value = "",
            Placeholder = "เช่น GunDrop",
            Callback = function(text)
                gunNameOverride = (text ~= "" and text) or nil
                gunCache = nil
                gunScanAt = 0
            end,
        })
    end)

    -- ---------- ยิงฆาตกร ----------
    Tab:Button({
        Title = "ยิงฆาตกร (กดครั้งเดียว)",
        Callback = function()
            local ok, why = shootMurderer()
            notify(ok and "ยิงฆาตกรแล้ว" or (why or "ยิงไม่ได้"))
        end,
    })

    Tab:Toggle({
        Title = "ปุ่มลอยยิงฆาตกร",
        Value = false,
        Callback = function(state)
            if shootGui then shootGui.Enabled = state end
        end,
    })

    local autoShoot = false
    Tab:Toggle({
        Title = "ออโต้ยิงฆาตกร",
        Value = false,
        Callback = function(state)
            autoShoot = state
            flags.autoShoot = state
        end,
    })

    task.spawn(function()
        while alive do
            task.wait(0.6)
            if autoShoot and hasTool(player, "Gun") then
                pcall(shootMurderer)
            end
        end
    end)
end)

