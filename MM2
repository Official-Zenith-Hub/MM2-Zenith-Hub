-- ==================================================
local function amPlaying()
    local hum = getHumanoid()
    if not hum or hum.Health <= 0 then return false end
    local info = roles[player.Name]
    if info and info.dead then return false end
    if rolesOk then
        return getRole(player) ~= nil and roundActive()
    end
    return true
end

local rawShoot, rawThrow = shootMurderer, throwKnife

shootMurderer = function()
    if not amPlaying() then
        return false, "คุณตายแล้วหรืออยู่ล็อบบี้ ยิงไม่ได้"
    end
    return rawShoot()
end

throwKnife = function()
    if not amPlaying() then
        return false, "คุณตายแล้วหรืออยู่ล็อบบี้ ขว้างมีดไม่ได้"
    end
    return rawThrow()
end

local function dumpRemotes()
    print("===== Zenith Hub: ตรวจระบบ =====")
    refreshRoles(true)
    print("Remote บทบาท:", rolesRemote and rolesRemote:GetFullName() or "หาไม่เจอ", "| อ่านบทบาทได้:", rolesOk)
    for _, toolName in ipairs({ "Gun", "Knife" }) do
        local tool = hasTool(player, toolName)
        if tool then
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                    print(toolName, "->", d:GetFullName(), "[" .. d.ClassName .. "]")
                end
            end
        else
            print(toolName, "-> ไม่มีในตัวเรา")
        end
    end
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            local n = d.Name:lower()
            if n:find("shoot") or n:find("gun") or n:find("knife") or n:find("throw")
                or n:find("role") or n:find("playerdata") then
                print("RS ->", d:GetFullName(), "[" .. d.ClassName .. "]")
            end
        end
    end
    print("บทบาทที่อ่านได้:")
    for name, info in pairs(roles) do print("  ", name, info.role, info.dead) end
    print("วัตถุที่ชื่อมีคำว่า gun (ค้นลึกทั้งหมด):")
    local n = 0
    for i, c in ipairs(workspace:GetDescendants()) do
        if c.Name:lower():find("gun") and (c:IsA("BasePart") or c:IsA("Model") or c:IsA("Tool")) then
            print("  ", c:GetFullName(), "[" .. c.ClassName .. "]")
            n += 1
        end
        if i % 500 == 0 then task.wait() end
    end
    print("เจอทั้งหมด", n, "ชิ้น")
    local g = getGunObject()
    print("ตัวหาปืนของสคริปต์:", g and g:GetFullName() or "ไม่เจอ")
    print("CoinContainer:", getCoinContainer())
    print("จำนวนเหรียญ:", #getCoins())
    print("กำลังเล่นอยู่ในรอบ:", amPlaying())
    print("================================")
    notify("พิมพ์ผลตรวจที่ Console แล้ว")
end

