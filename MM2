-- ==================================================
-- ยิงปืน / ขว้างมีด (มีตัวสำรองหลายแบบ)
-- ==================================================
local function shootMurderer()
    refreshRoles(true)
    local murderer = getMurderer()
    if not murderer then return false, "ไม่เจอฆาตกร (ยังไม่เริ่มรอบหรือตายแล้ว)" end
    if not hasTool(player, "Gun") then return false, "คุณไม่มีปืน" end
    local hrp = murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "ไม่เจอตัวฆาตกร" end
    local gun = equipTool("Gun")
    if not gun then return false, "หยิบปืนไม่ได้" end

    local root = getRoot()
    local aimPos = hrp.Position + hrp.AssemblyLinearVelocity * 0.1
    local shootGunRemote = gun:FindFirstChild("ShootGun", true)

    local candidates = {
        function() gun.KnifeLocal.CreateBeam.RemoteFunction:InvokeServer(1, aimPos, "AH2") end,
        function() shootGunRemote:InvokeServer(1, aimPos, "AH2") end,
        function() gun.Shoot:FireServer(CFrame.new(root.Position), CFrame.new(aimPos)) end,
    }
    for _, f in ipairs(candidates) do
        if pcall(f) then return true end
    end
    return false, "คำสั่งยิงของเกมเปลี่ยน (กดปุ่ม ตรวจระบบ ในแท็บ อื่นๆ)"
end

local function throwKnife()
    if not hasTool(player, "Knife") then return false, "คุณไม่ใช่ฆาตกร (ไม่มีมีด)" end
    local target = getNearestPlayer()
    if not target then return false, "ไม่เจอเป้าหมาย" end
    local hrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    local root = getRoot()
    if not (hrp and root) then return false, "ไม่เจอตัวเป้าหมาย" end
    local knife = equipTool("Knife")
    if not knife then return false, "หยิบมีดไม่ได้" end

    local aimPos = hrp.Position + hrp.AssemblyLinearVelocity * 0.15
    local from, to = CFrame.new(root.Position), CFrame.new(aimPos)

    local candidates = {
        function() knife.Throw:FireServer(from, to) end,
        function() knife.Events.KnifeThrown:FireServer(from, to) end,
        function() knife.KnifeServer.KnifeServer:FireServer(aimPos, knife.Handle.Position) end,
    }
    for _, f in ipairs(candidates) do
        if pcall(f) then return true end
    end
    return false, "คำสั่งขว้างมีดของเกมเปลี่ยน (กดปุ่ม ตรวจระบบ ในแท็บ อื่นๆ)"
end

