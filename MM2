local coinContainerCache, coinScanAt = nil, 0
local function getCoinContainer()
    if coinContainerCache and coinContainerCache.Parent then return coinContainerCache end
    if tick() - coinScanAt < 2 then return nil end
    coinScanAt = tick()
    for _, m in ipairs(workspace:GetChildren()) do
        local c = m:FindFirstChild("CoinContainer")
        if c then
            coinContainerCache = c
            return c
        end
    end
    coinContainerCache = workspace:FindFirstChild("CoinContainer", true)
    return coinContainerCache
end

local function getCoins()
    local coins = {}
    local container = getCoinContainer()
    if container then
        for _, c in ipairs(container:GetDescendants()) do
            if c:IsA("BasePart") and c.Name == "Coin_Server" then
                table.insert(coins, c)
            end
        end
    end
    return coins
end

