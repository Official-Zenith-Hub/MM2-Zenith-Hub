    local grayColor = ColorSequence.new(Color3.fromRGB(120, 120, 120), Color3.fromRGB(60, 60, 60))

    local grad = Instance.new("UIGradient", btn)
    grad.Rotation = 90
    grad.Color = normalColor

    local stroke = Instance.new("UIStroke", btn)
