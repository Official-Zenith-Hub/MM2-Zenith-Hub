local flags = {}
local roles = {}
local rolesOk = false
local rolesRemote, remoteScanAt = nil, 0
local lastRoleRefresh = 0

local function findRolesRemote()
    if rolesRemote and rolesRemote.Parent then return rolesRemote end
    if tick() - remoteScanAt < 5 then return nil end
    remoteScanAt = tick()
    local r = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if r and r:IsA("RemoteFunction") then rolesRemote = r end
    return rolesRemote
end

local function refreshRoles(force)
    if not force and tick() - lastRoleRefresh < 1 then return end
    lastRoleRefresh = tick()
    local fn = findRolesRemote()
    if not fn then return end
    local ok, data = pcall(function() return fn:InvokeServer() end)
    if ok and typeof(data) == "table" then
        local new = {}
        for name, info in pairs(data) do
            if typeof(info) == "table" then
                new[name] = { role = info.Role or info.role, dead = info.Dead or info.dead }
            end
        end
        roles = new
        rolesOk = true
    end
end

-- คืนค่า "Murderer" / "Sheriff" / "Hero" / "Innocent" หรือ nil (ยังไม่เริ่มรอบ)
local function getRole(p)
    local info = roles[p.Name]
    local r = info and info.role
    if r == "Murderer" or r == "Sheriff" or r == "Hero" or r == "Innocent" then
        return r
    end
    local c = p.Character
    if c and c:FindFirstChild("Knife") then return "Murderer" end
    if c and c:FindFirstChild("Gun") then return "Sheriff" end
    return nil
end

local function roundActive()
    for _, p in ipairs(Players:GetPlayers()) do
        local r = getRole(p)
        if r == "Murderer" or r == "Sheriff" or r == "Hero" then return true end
    end
    return false
end

-- อยู่ในรอบหรือไม่ (ถ้าอ่านบทบาทไม่ได้ ถือว่าอยู่ในรอบไว้ก่อน)
local function inRound()
    return (not rolesOk) or roundActive()
end

local function isAlive(p)
    local info = roles[p.Name]
    if info and info.dead then return false end
    local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and getRole(p) == "Murderer" and isAlive(p) then
            return p
        end
    end
end

local function getNearestPlayer()
    local root = getRoot()
    if not root then return end
    local best, bestDist
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and isAlive(p) then
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            if h then
                local d = (h.Position - root.Position).Magnitude
                if not bestDist or d < bestDist then
                    best, bestDist = p, d
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while alive do
        task.wait(1)
        if flags.esp or flags.grab or flags.autoShoot or flags.farm or flags.autoThrow then
            pcall(refreshRoles, true)
        end
    end
end)

