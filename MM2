safe("ฟาร์ม", function()
    local Tab = Window:Tab({ Title = "ฟาร์ม", Icon = "coins" })

    local farmOn, safeFarm, farmSpeed = false, true, 30

    Tab:Toggle({
        Title = "ฟาร์มเหรียญอัตโนมัติ",
        Value = false,
        Callback = function(state)
            farmOn = state
            flags.farm = state
        end,
    })
    Tab:Toggle({
        Title = "ฟาร์มแบบปลอดภัย (หลบฆาตกร)",
        Value = true,
        Callback = function(state) safeFarm = state end,
    })
    Tab:Slider({
        Title = "ความเร็วฟาร์ม",
        Value = { Min = 15, Max = 80, Default = 30 },
        Callback = function(v) farmSpeed = v end,
    })

    task.spawn(function()
        while alive do
            task.wait(0.15)
            if farmOn and not grabbing then
                local root = getRoot()
                local coins = root and getCoins() or {}
                if root and #coins > 0 then
                    local murderer = safeFarm and getMurderer()
                    local mRoot = murderer and murderer.Character
                        and murderer.Character:FindFirstChild("HumanoidRootPart")

                    local best, bestDist
                    for _, coin in ipairs(coins) do
                        local ok = true
                        if mRoot and (coin.Position - mRoot.Position).Magnitude < 30 then
                            ok = false
                        end
                        if ok then
                            local d = (coin.Position - root.Position).Magnitude
                            if not bestDist or d < bestDist then
                                best, bestDist = coin, d
                            end
                        end
                    end

                    if best then
                        local dur = math.max(bestDist / farmSpeed, 0.1)
                        local tw = TweenService:Create(
                            root,
                            TweenInfo.new(dur, Enum.EasingStyle.Linear),
                            { CFrame = best.CFrame }
                        )
                        tw:Play()
                        local t = 0
                        while alive and t < dur + 0.25 and farmOn and root.Parent
                            and best.Parent and best.Name == "Coin_Server" do
                            task.wait(0.05)
                            t += 0.05
                        end
                        tw:Cancel()
                        if firetouchinterest and best.Parent then
                            pcall(function()
                                firetouchinterest(root, best, 0)
                                firetouchinterest(root, best, 1)
                            end)
                        end
                    end
                end
            end
        end
    end)
end)

